          <folder-item name='[Calculation_1]' type='field' />
          <folder-item name='[Calculation_3]' type='field' />
        </folder>
        <folder name='Product'>
          <folder-item name='[Product Type]' type='field' />
        </folder>
        <folder name='Empty'>
