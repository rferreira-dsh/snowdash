        <calculation class='tableau' formula='#2026-09-30#' />
      </column>
    </datasource>
    <datasource caption='SALES_CUBE' inline='true' name='federated.abc123' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='acme.snowflakecomputing.com' name='snowflake.x1'>
            <connection authentication='Username Password' class='snowflake' dbname='EDW' schema='SALES' warehouse='REPORTING_WH' />
          </named-connection>
        </named-connections>
        <relation type='collection'>
          <relation connection='snowflake.x1' name='FACT_SALES' table='[EDW].[SALES].[FACT_SALES]' type='table' />
          <relation connection='snowflake.x1' name='DIM_DATE' table='[EDW].[CALENDAR].[DIM_DATE]' type='table' />
          <relation connection='snowflake.x1' name='DIM_PRODUCT' table='[EDW].[SALES].[DIM_PRODUCT]' type='table' />
          <relation connection='snowflake.x1' name='ORPHAN' table='[EDW].[SALES].[ORPHAN]' type='table' />
        </relation>
        <cols>
          <map key='[AMOUNT]' value='[FACT_SALES].[AMOUNT]' />
        </cols>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>SALEDATE</remote-name><local-name>[SALEDATE]</local-name><parent-name>[FACT_SALES]</parent-name><local-type>date</local-type>
            <object-id>[FACT_SALES_OBJ]</object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>PRODUCTKEY</remote-name><local-name>[PRODUCTKEY]</local-name><parent-name>[FACT_SALES]</parent-name><local-type>string</local-type>
