          </object>
          <object caption='ORPHAN' id='ORPHAN_OBJ'>
            <properties context=''><relation connection='snowflake.x1' name='ORPHAN' table='[EDW].[SALES].[ORPHAN]' type='table' /></properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='='><expression op='[SALEDATE]' /><expression op='[DATE (DIM_DATE)]' /></expression>
            <first-end-point object-id='FACT_SALES_OBJ' /><second-end-point object-id='DIM_DATE_OBJ' unique-key='true' />
          </relationship>
          <relationship>
            <expression op='='><expression op='int([PRODUCTKEY])' /><expression op='[PRODUCTKEY (DIM_PRODUCT)]' /></expression>
            <first-end-point object-id='FACT_SALES_OBJ' /><second-end-point object-id='DIM_PRODUCT_OBJ' />
          </relationship>
        </relationships>
      </object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Totals by product'>
      <table>
        <view>
          <datasources><datasource caption='SALES_CUBE' name='federated.abc123' /></datasources>
          <filter class='categorical' column='[federated.abc123].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.abc123].[sum:AMOUNT:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.abc123].[ctd:Order ID:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.abc123].[usr:Calculation_1:qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.abc123].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.abc123].[usr:Calculation_1:qk]&quot;</bucket>
              <bucket>&quot;[federated.abc123].[sum:AMOUNT:qk]&quot;</bucket>
              <bucket>&quot;[federated.abc123].[ctd:Order ID:qk]&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.abc123].[none:DATE (DIM_DATE):ok]'>
            <groupfilter function='member' level='[none:DATE (DIM_DATE):ok]' member='#2026-09-30#' />
          </filter>
          <filter class='categorical' column='[federated.abc123].[none:Product Type:nk]'>
            <groupfilter function='except'>
              <groupfilter function='level-members' level='[none:Product Type:nk]' />
              <groupfilter function='member' level='[none:Product Type:nk]' member='&quot;XYZ&quot;' />
            </groupfilter>
          </filter>
          <filter class='relative-date' column='[federated.abc123].[none:SALEDATE:qk]' period-type-v2='year' />
          <filter class='quantitative' column='[federated.abc123].[__tableau_internal_object_id__].[cnt:FACT_SALES_OBJ:qk]' included-values='in-range'>
            <min>2</min>
          </filter>
        </view>
        <panes>
          <pane><mark class='Automatic' /><encodings><text column='[federated.abc123].[Multiple Values]' /></encodings></pane>
        </panes>
        <rows total='true'>([federated.abc123].[none:Product Type:nk] / [federated.abc123].[none:Calculation_3:nk])</rows>
        <cols>[federated.abc123].[:Measure Names]</cols>
      </table>
    </worksheet>
    <worksheet name='Over time'>
      <table>
        <view>
          <datasources><datasource caption='SALES_CUBE' name='federated.abc123' /></datasources>
          <filter class='categorical' column='[federated.abc123].[tmn:DATE (DIM_DATE):ok]'>
            <groupfilter function='union'>
              <groupfilter function='member' level='[tmn:DATE (DIM_DATE):ok]' member='#2026-01-01 00:00:00#' />
              <groupfilter function='member' level='[tmn:DATE (DIM_DATE):ok]' member='#2026-03-01 00:00:00#' />
            </groupfilter>
          </filter>
        </view>
        <panes>
          <pane><mark class='Line' /><encodings><text column='[federated.abc123].[cnt:FACT_SALES_OBJ:qk]' /></encodings></pane>
        </panes>
        <rows>[federated.abc123].[sum:AMOUNT:qk]</rows>
        <cols>[federated.abc123].[tmn:DATE (DIM_DATE):ok]</cols>
      </table>
    </worksheet>
  </worksheets>
</workbook>
