            <remote-name>DATE</remote-name><local-name>[DATE (DIM_DATE)]</local-name><parent-name>[DIM_DATE]</parent-name><local-type>date</local-type>
            <object-id>[DIM_DATE_OBJ]</object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>PRODUCTKEY</remote-name><local-name>[PRODUCTKEY (DIM_PRODUCT)]</local-name><parent-name>[DIM_PRODUCT]</parent-name><local-type>integer</local-type>
            <object-id>[DIM_PRODUCT_OBJ]</object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Product Type</remote-name><local-name>[Product Type]</local-name><parent-name>[DIM_PRODUCT]</parent-name><local-type>string</local-type>
            <object-id>[DIM_PRODUCT_OBJ]</object-id>
          </metadata-record>
        </metadata-records>
      </connection>
      <column caption='Amount' datatype='real' name='[AMOUNT]' role='measure' type='quantitative' />
      <column caption='Order ID' datatype='string' name='[Order ID]' role='dimension' type='nominal' />
      <column caption='Productkey' datatype='string' hidden='true' name='[PRODUCTKEY]' role='dimension' type='nominal' />
      <column caption='As of Date' datatype='date' name='[DATE (DIM_DATE)]' role='dimension' type='ordinal' />
      <column caption='Avg Ticket' datatype='real' name='[Calculation_1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AMOUNT]) / COUNTD([Order ID])' />
      </column>
      <column caption='PPL Amount' datatype='real' name='[Calculation_2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Product Type] = &quot;PPL&quot;, ZN([AMOUNT]), 0))' />
      </column>
      <column caption='Is Month End' datatype='boolean' name='[Calculation_3]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATE([DATE (DIM_DATE)]) =&#10;DATE(DATETRUNC(&apos;month&apos;, [DATE (DIM_DATE)]))' />
      </column>
      <column caption='As of Filter' datatype='boolean' name='[Calculation_4]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[DATE (DIM_DATE)]=[Parameters].[Parameter 1]' />
      </column>
      <folders-common>
        <folder name='Measures'>
